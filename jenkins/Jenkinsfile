pipeline {
    agent any

    environment {
        REGISTRY       = 'hemaswathi2002'         // ← Docker Hub username
        IMAGE_TAG      = "${env.BUILD_NUMBER}"
        DOCKER_CREDS   = 'docker-hub-credentials' // ← Jenkins credential ID
        GIT_CREDENTIALS = 'github-credentials'    // ← Jenkins credential ID for Git
        GIT_REPO       = 'https://github.com/hemaswathi2002/microservice-deployment.git'
        BRANCH         = 'main'                   // ← Adjust branch if needed
    }

    tools {
        maven 'Maven-3.9'
        jdk   'JDK-17'
    }

    stages {

        stage('Checkout') {
            steps {
                echo '── Cloning repository ──'
                checkout scm
            }
        }

        stage('Code Quality Check') {
            steps {
                dir('backend') {
                    echo '── Running code quality checks ──'
                    sh 'mvn checkstyle:check'
                }
            }
        }

        stage('Test') {
            steps {
                dir('backend') {
                    echo '── Running unit tests ──'
                    sh 'mvn clean test'
                    junit allowEmptyResults: true, testResults: '**/target/surefire-reports/*.xml'
                }
            }
        }

        stage('Package') {
            steps {
                dir('backend') {
                    echo '── Building JAR ──'
                    sh 'mvn package -DskipTests'
                    archiveArtifacts artifacts: 'target/*.jar', fingerprint: true
                }
            }
        }

        stage('Docker Build') {
            steps {
                echo '── Building Docker images ──'
                sh """
                    docker build -t ${REGISTRY}/micro-backend:${IMAGE_TAG}  \
                                 -t ${REGISTRY}/micro-backend:latest         \
                                 ./backend

                    docker build -t ${REGISTRY}/micro-frontend:${IMAGE_TAG} \
                                 -t ${REGISTRY}/micro-frontend:latest        \
                                 ./frontend
                """
            }
        }

        stage('Security Scan') {
            steps {
                echo '── Scanning Docker images with Trivy ──'
                sh """
                    docker run --rm -v /var/run/docker.sock:/var/run/docker.sock \
                        aquasec/trivy:latest image --exit-code 0 --no-progress \
                        ${REGISTRY}/micro-backend:${IMAGE_TAG}

                    docker run --rm -v /var/run/docker.sock:/var/run/docker.sock \
                        aquasec/trivy:latest image --exit-code 0 --no-progress \
                        ${REGISTRY}/micro-frontend:${IMAGE_TAG}
                """
            }
        }

        stage('Docker Push') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: env.DOCKER_CREDS,
                    usernameVariable: 'DOCKER_USER',
                    passwordVariable: 'DOCKER_PASS'
                )]) {
                    sh 'echo "$DOCKER_PASS" | docker login -u "$DOCKER_USER" --password-stdin'
                    sh """
                        docker push ${REGISTRY}/micro-backend:${IMAGE_TAG}
                        docker push ${REGISTRY}/micro-backend:latest
                        docker push ${REGISTRY}/micro-frontend:${IMAGE_TAG}
                        docker push ${REGISTRY}/micro-frontend:latest
                    """
                    sh 'docker logout'
                }
            }
        }

        stage('Update Helm Chart') {
            steps {
                echo '── Updating Helm values.yaml with new image tags ──'
                sh """
                    sed -i 's/tag: .*/tag: "${IMAGE_TAG}"/' helm-chart/values.yaml
                """
            }
        }

        stage('Commit and Push Changes') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: env.GIT_CREDENTIALS,
                    usernameVariable: 'GIT_USER',
                    passwordVariable: 'GIT_PASS'
                )]) {
                    sh """
                        git config user.email "jenkins@ci.com"
                        git config user.name "Jenkins CI"
                        git add helm-chart/values.yaml
                        git commit -m "Update image tags to ${IMAGE_TAG}" || echo "No changes to commit"
                        git push https://${GIT_USER}:${GIT_PASS}@github.com/hemaswathi2002/microservice-deployment.git ${BRANCH}
                    """
                }
            }
        }
    }

    post {
        success {
            echo "✅ Build #${env.BUILD_NUMBER} completed successfully! ArgoCD will sync automatically."
        }
        failure {
            echo "❌ Build #${env.BUILD_NUMBER} failed."
        }
        always {
            sh """
                docker rmi ${REGISTRY}/micro-backend:${IMAGE_TAG}  || true
                docker rmi ${REGISTRY}/micro-frontend:${IMAGE_TAG} || true
            """
            cleanWs()
        }
    }
}
